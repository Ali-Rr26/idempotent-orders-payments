                  "const products = pm.response.json();",
                  "const stock = id => products.find(p => p.id === id).stock;",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Producto 1 tiene stock 3\", () => pm.expect(stock(1)).to.eql(3));",
                  "pm.test(\"Producto 2 tiene stock 1\", () => pm.expect(stock(2)).to.eql(1));",
