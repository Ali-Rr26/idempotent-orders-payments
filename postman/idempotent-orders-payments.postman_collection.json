{
  "info": {
    "name": "Idempotent Orders & Payments",
    "description": "Casos obligatorios del reto: pedidos, pagos simulados e idempotencia.\n\nCorrer la colección completa en orden (Collection Runner o `newman run`). La carpeta 0 reinicia ambos servicios y genera claves nuevas; dentro de una corrida, reenviar una request reutiliza su clave (mismo intento).\n\nRequiere los dos servicios levantados (local o `docker compose up`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "order_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "payment_url",
      "value": "http://127.0.0.1:5001"
    },
    {
      "key": "key_ok",
      "value": ""
    },
    {
      "key": "key_timeout",
      "value": ""
    },
    {
      "key": "key_reject",
      "value": ""
    },
    {
      "key": "key_a",
      "value": ""
    },
    {
      "key": "key_b",
      "value": ""
    },
    {
      "key": "order_ok_id",
      "value": ""
    },
    {
      "key": "order_timeout_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Preparación",
      "description": "Reinicia ambas bases, genera claves nuevas y verifica el stock inicial.",
      "item": [
        {
          "name": "Reiniciar Order API",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{order_url}}/admin/reset",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "admin",
                "reset"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Claves nuevas en cada corrida: la misma clave dentro de la corrida = mismo intento.",
                  "[\"key_ok\", \"key_timeout\", \"key_reject\", \"key_a\", \"key_b\"].forEach(name =>",
                  "  pm.collectionVariables.set(name, name.replace(\"key_\", \"\") + \"-\" + pm.variables.replaceIn(\"{{$guid}}\"))",
                  ");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reiniciar Payment Mock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{payment_url}}/admin/reset",
              "host": [
                "{{payment_url}}"
              ],
              "path": [
                "admin",
                "reset"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock inicial",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_url}}/products",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json();",
                  "const stock = id => products.find(p => p.id === id).stock;",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Producto 1 tiene stock 5\", () => pm.expect(stock(1)).to.eql(5));",
                  "pm.test(\"Producto 2 tiene stock 1\", () => pm.expect(stock(2)).to.eql(1));",
                  "pm.test(\"Ningún stock es negativo\", () => products.forEach(p => pm.expect(p.stock).to.be.at.least(0)));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Flujo exitoso",
      "description": "Un pedido, una reserva, un cobro y estado final PAID.",
      "item": [
        {
          "name": "Crear pedido (pago aprobado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{key_ok}}"
              }
            ],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1,\n  \"payment_mode\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const order = pm.response.json();",
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Pedido PAID\", () => pm.expect(order.status).to.eql(\"PAID\"));",
                  "pm.test(\"Reserva CONSUMED\", () => pm.expect(order.reservation.status).to.eql(\"CONSUMED\"));",
                  "pm.test(\"No es un replay\", () => pm.expect(pm.response.headers.has(\"Idempotent-Replayed\")).to.be.false);",
                  "pm.collectionVariables.set(\"order_ok_id\", order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Stock descontado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_url}}/products",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json();",
                  "const stock = id => products.find(p => p.id === id).stock;",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Producto 1 tiene stock 4\", () => pm.expect(stock(1)).to.eql(4));",
                  "pm.test(\"Producto 2 tiene stock 1\", () => pm.expect(stock(2)).to.eql(1));",
                  "pm.test(\"Ningún stock es negativo\", () => products.forEach(p => pm.expect(p.stock).to.be.at.least(0)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Un cobro aprobado en el mock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{payment_url}}/payments",
              "host": [
                "{{payment_url}}"
              ],
              "path": [
                "payments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const key = \"pay-\" + pm.collectionVariables.get(\"key_ok\");",
                  "const matches = pm.response.json().filter(p => p.payment_key === key);",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Existe exactamente 1 cobro para \" + key, () => pm.expect(matches.length).to.eql(1));",
                  "pm.test(\"El cobro está APPROVED\", () => pm.expect(matches[0].status).to.eql(\"APPROVED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
