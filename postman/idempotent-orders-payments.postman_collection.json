                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Existe exactamente 1 cobro para \" + key, () => pm.expect(matches.length).to.eql(1));",
                  "pm.test(\"El cobro está APPROVED\", () => pm.expect(matches[0].status).to.eql(\"APPROVED\"));"
                ]
