    {
      "name": "3. Respuesta perdida después del cobro",
      "description": "El mock registra el cobro y tarda 5 s en responder; la Order API corta a los 2 s y deja el pedido PAYMENT_UNCERTAIN. El reintento con la misma clave consulta el pago y reconcilia sin cobrar de nuevo.",
      "item": [
        {
          "name": "Crear pedido (timeout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{key_timeout}}"
              }
            ],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1,\n  \"payment_mode\": \"timeout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const order = pm.response.json();",
                  "pm.test(\"Status 202 (resultado incierto)\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Pedido PAYMENT_UNCERTAIN\", () => pm.expect(order.status).to.eql(\"PAYMENT_UNCERTAIN\"));",
                  "pm.test(\"Reserva sigue RESERVED\", () => pm.expect(order.reservation.status).to.eql(\"RESERVED\"));",
                  "pm.test(\"Indica el motivo\", () => pm.expect(order.failure_reason).to.include(\"Timeout\"));",
                  "pm.collectionVariables.set(\"order_timeout_id\", order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "El mock ya registró el cobro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{payment_url}}/payments/pay-{{key_timeout}}",
              "host": [
                "{{payment_url}}"
              ],
              "path": [
                "payments",
                "pay-{{key_timeout}}"
              ]
            },
            "description": "Demuestra que el cobro ocurrió aunque la Order API no recibió la respuesta."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El cobro existe y está APPROVED\", () => pm.expect(pm.response.json().status).to.eql(\"APPROVED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reintentar pedido (misma clave)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{key_timeout}}"
              }
            ],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1,\n  \"payment_mode\": \"timeout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const order = pm.response.json();",
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Header Idempotent-Replayed: true\", () => pm.response.to.have.header(\"Idempotent-Replayed\", \"true\"));",
                  "pm.test(\"Mismo pedido\", () => pm.expect(order.id).to.eql(Number(pm.collectionVariables.get(\"order_timeout_id\"))));",
                  "pm.test(\"Reconciliado a PAID\", () => pm.expect(order.status).to.eql(\"PAID\"));",
                  "pm.test(\"reconciled_at registrado\", () => pm.expect(order.reconciled_at).to.be.a(\"string\"));",
                  "pm.test(\"Reserva CONSUMED\", () => pm.expect(order.reservation.status).to.eql(\"CONSUMED\"));"
                ]
              }
            }
          ]
        },
